// cli.matrix — Global CLI executable entrypoint for Spid3r nettools (`spkg tool install nettools`).

import "lib" as nt;

fn print_usage() {
    println("nettools v" + nt.VERSION + " — Cross-platform network diagnostics toolkit (" + nt.detect_os() + ")");
    println("");
    println("USAGE:");
    println("  nettools <command> [args...] [--json]");
    println("  nettools-server                 Start loopback HTTP companion server (NETTOOLS_PORT=8787)");
    println("");
    println("IP & CIDR MATH (OFFLINE):");
    println("  subnet <cidr>                   CIDR breakdown (network, netmask, broadcast, hosts)");
    println("  range <start-ip> <end-ip>       Aggregate IPv4 range into CIDR blocks");
    println("  ip <ipv4> | classify <ipv4>     IPv4 class, RFC scope, and routability");
    println("");
    println("CONNECTIVITY, DNS, HTTP & RDAP:");
    println("  port <host> <port>              Single TCP handshake port check");
    println("  tcpping <host> [port] [count]   Sequential TCP ping probes (defaults: 443, 4)");
    println("  dns <host> [type]               DNS-over-HTTPS JSON query (default type: A)");
    println("  http <url> [method]             HTTP/HTTPS status, headers & body preview (default: GET)");
    println("  whois <query> | rdap <query>    RDAP lookup for domain, IP, or ASN");
    println("");
    println("OS DIAGNOSTICS:");
    println("  ping <host> [count]             ICMP ping via OS tool (default count: 4)");
    println("  trace <host>                    Traceroute / tracert to host");
    println("  nslookup <host> [type]          OS nslookup query");
    println("  dig <host> [type]               OS dig query");
    println("  ssl <host> [port]               OpenSSL s_client TLS check (default port: 443)");
    println("  ipconfig | ifconfig | hostname | arp | route | interfaces");
    println("  netstat | connections | open_ports | net_stats");
    println("");
    println("FLAGS:");
    println("  --json                          Emit machine-readable JSON output");
    println("  -h, --help                      Show this help message");
    println("  -V, --version                   Print version and host OS");
}

fn emit_err(as_json: bool, msg: string, code: int) -> int {
    if as_json {
        println(json_write(map("ok", false, "error", msg)));
    } else {
        println("error: " + msg);
    }
    return code;
}

fn parse_int_or(s: string, fallback: int) -> int {
    try {
        return int(s);
    } catch (_e) {
        return fallback;
    }
}

fn run_os_tool(tool: string, params: map, as_json: bool) -> int {
    let res = nt.run_os_command(tool, params);
    if as_json {
        println(json_write(res));
        if res["ok"] == true {
            return 0;
        }
        return 1;
    }
    let out = string(res["stdout"]);
    let err_out = string(res["stderr"]);
    if len(out.trim()) > 0 {
        println(out.trim());
    }
    if len(err_out.trim()) > 0 {
        println(err_out.trim());
    }
    if res["ok"] == true {
        return 0;
    }
    return 1;
}

fn main() {
    let raw = args();
    let pos = list();
    let as_json = false;
    let i = 0;
    while i < len(raw) {
        let a = string(raw[i]);
        if a == "--json" {
            as_json = true;
        } elif a == "--help" or a == "-h" {
            print_usage();
            return 0;
        } elif a == "--version" or a == "-V" {
            if as_json {
                println(json_write(map("name", "nettools", "version", nt.VERSION, "os", nt.detect_os())));
            } else {
                println("nettools " + nt.VERSION + " (" + nt.detect_os() + ")");
            }
            return 0;
        } else {
            pos.push(a);
        }
        i += 1;
    }

    if len(pos) == 0 {
        print_usage();
        return 0;
    }

    let sub = string(pos[0]).trim().lower();
    if sub == "help" {
        print_usage();
        return 0;
    }
    if sub == "version" {
        if as_json {
            println(json_write(map("name", "nettools", "version", nt.VERSION, "os", nt.detect_os())));
        } else {
            println("nettools " + nt.VERSION + " (" + nt.detect_os() + ")");
        }
        return 0;
    }

    if sub == "subnet" {
        if len(pos) < 2 {
            return emit_err(as_json, "usage: nettools subnet <cidr>", 2);
        }
        let r = nt.subnet_calc(string(pos[1]));
        if r.is_err() {
            return emit_err(as_json, string(r.unwrap_err()), 1);
        }
        let d = r.unwrap();
        if as_json {
            println(json_write(map("ok", true, "data", d)));
            return 0;
        }
        println("CIDR:       " + string(d["cidr"]));
        println("Network:    " + string(d["network"]) + " / Netmask: " + string(d["netmask"]));
        println("Wildcard:   " + string(d["wildcard"]) + " / Broadcast: " + string(d["broadcast"]));
        println("Usable:     " + string(d["first_host"]) + " - " + string(d["last_host"]) + " (" + string(d["usable_hosts"]) + " / " + string(d["total_addresses"]) + ")");
        println("Class:      " + string(d["ip_class"]) + " (" + string(d["scope"]) + ")");
        return 0;
    }

    if sub == "range" {
        if len(pos) < 3 {
            return emit_err(as_json, "usage: nettools range <start-ip> <end-ip>", 2);
        }
        let r = nt.ip_range_calc(string(pos[1]), string(pos[2]));
        if r.is_err() {
            return emit_err(as_json, string(r.unwrap_err()), 1);
        }
        let d = r.unwrap();
        if as_json {
            println(json_write(map("ok", true, "data", d)));
            return 0;
        }
        println("Range:      " + string(d["start"]) + " - " + string(d["end"]) + " (" + string(d["total_addresses"]) + " addresses)");
        println("CIDRs:      " + d["cidrs"].join(", "));
        return 0;
    }

    if sub == "ip" or sub == "classify" {
        if len(pos) < 2 {
            return emit_err(as_json, "usage: nettools ip <ipv4>", 2);
        }
        let r = nt.classify_ipv4(string(pos[1]));
        if r.is_err() {
            return emit_err(as_json, string(r.unwrap_err()), 1);
        }
        let d = r.unwrap();
        if as_json {
            println(json_write(map("ok", true, "data", d)));
            return 0;
        }
        println("IP:         " + string(d["ip"]));
        println("Class:      " + string(d["class"]) + " / Scope: " + string(d["scope"]));
        println("RFC:        " + string(d["rfc"]) + " / Routable: " + string(d["is_routable"]));
        println("Details:    " + string(d["description"]));
        return 0;
    }

    if sub == "port" {
        if len(pos) < 3 {
            return emit_err(as_json, "usage: nettools port <host> <port>", 2);
        }
        let port_num = parse_int_or(string(pos[2]), 0);
        let r = nt.check_port(string(pos[1]), port_num);
        if r.is_err() {
            return emit_err(as_json, string(r.unwrap_err()), 1);
        }
        let d = r.unwrap();
        if as_json {
            println(json_write(map("ok", true, "data", d)));
            return 0;
        }
        println("Address:    " + string(d["address"]) + " -> open=" + string(d["open"]) + " (" + string(d["rtt_ms"]) + " ms: " + string(d["message"]) + ")");
        return 0;
    }

    if sub == "tcpping" {
        if len(pos) < 2 {
            return emit_err(as_json, "usage: nettools tcpping <host> [port] [count]", 2);
        }
        let p = 443;
        if len(pos) >= 3 {
            p = parse_int_or(string(pos[2]), 443);
        }
        let c = 4;
        if len(pos) >= 4 {
            c = parse_int_or(string(pos[3]), 4);
        }
        let r = nt.tcp_ping(string(pos[1]), p, c);
        if r.is_err() {
            return emit_err(as_json, string(r.unwrap_err()), 1);
        }
        let d = r.unwrap();
        if as_json {
            println(json_write(map("ok", true, "data", d)));
            return 0;
        }
        println("TCP Ping " + string(d["address"]) + ": sent=" + string(d["sent"]) + " recv=" + string(d["received"]) + " loss=" + string(d["loss_pct"]) + "% min/avg/max=" + string(d["min_ms"]) + "/" + string(d["avg_ms"]) + "/" + string(d["max_ms"]) + " ms");
        return 0;
    }

    if sub == "dns" {
        if len(pos) < 2 {
            return emit_err(as_json, "usage: nettools dns <host> [type]", 2);
        }
        let rtype = "A";
        if len(pos) >= 3 {
            rtype = string(pos[2]);
        }
        let r = nt.dns_doh(string(pos[1]), rtype);
        if r.is_err() {
            return emit_err(as_json, string(r.unwrap_err()), 1);
        }
        let d = r.unwrap();
        if as_json {
            println(json_write(map("ok", true, "data", d)));
            return 0;
        }
        let resp = d["response"];
        println("DNS " + string(d["name"]) + " " + string(d["type"]) + " via " + string(d["provider"]) + " (" + string(d["duration_ms"]) + " ms, Status=" + string(resp["Status"]) + ")");
        if resp.has("Answer") and type_of(resp["Answer"]) == "list" {
            let ans = resp["Answer"];
            let j = 0;
            while j < len(ans) {
                let rec = ans[j];
                println("  " + string(rec["name"]) + "  TTL=" + string(rec["TTL"]) + "  " + string(rec["data"]));
                j += 1;
            }
        } else {
            println("  (no Answer records)");
        }
        return 0;
    }

    if sub == "http" {
        if len(pos) < 2 {
            return emit_err(as_json, "usage: nettools http <url> [method]", 2);
        }
        let method = "GET";
        if len(pos) >= 3 {
            method = string(pos[2]);
        }
        let r = nt.http_inspect(method, string(pos[1]), null, null);
        if r.is_err() {
            return emit_err(as_json, string(r.unwrap_err()), 1);
        }
        let d = r.unwrap();
        if as_json {
            println(json_write(map("ok", true, "data", d)));
            return 0;
        }
        println("HTTP " + string(d["method"]) + " " + string(d["url"]) + " -> " + string(d["status"]) + " (" + string(d["duration_ms"]) + " ms)");
        let body = string(d["body"]);
        if len(body) > 1024 {
            println(body.slice(0, 1024) + "\n... [truncated; pass --json for full body]");
        } elif len(body.trim()) > 0 {
            println(body.trim());
        }
        return 0;
    }

    if sub == "whois" or sub == "rdap" {
        if len(pos) < 2 {
            return emit_err(as_json, "usage: nettools " + sub + " <domain|ip|asn>", 2);
        }
        let r = nt.whois_rdap(string(pos[1]));
        if r.is_err() {
            return emit_err(as_json, string(r.unwrap_err()), 1);
        }
        let d = r.unwrap();
        if as_json {
            println(json_write(map("ok", true, "data", d)));
            return 0;
        }
        println("RDAP HTTP " + string(d["status"]) + " (" + string(d["duration_ms"]) + " ms) " + string(d["url"]));
        let body = string(d["body"]);
        if len(body) > 1024 {
            println(body.slice(0, 1024) + "\n... [truncated; pass --json for full body]");
        } else {
            println(body.trim());
        }
        return 0;
    }

    if sub == "ping" {
        if len(pos) < 2 {
            return emit_err(as_json, "usage: nettools ping <host> [count]", 2);
        }
        let c = 4;
        if len(pos) >= 3 {
            c = parse_int_or(string(pos[2]), 4);
        }
        return run_os_tool("ping", map("host", string(pos[1]), "count", c), as_json);
    }

    if sub == "trace" or sub == "traceroute" {
        if len(pos) < 2 {
            return emit_err(as_json, "usage: nettools trace <host>", 2);
        }
        return run_os_tool("traceroute", map("host", string(pos[1])), as_json);
    }

    if sub == "nslookup" or sub == "dig" {
        if len(pos) < 2 {
            return emit_err(as_json, "usage: nettools " + sub + " <host> [type]", 2);
        }
        let rtype = "A";
        if len(pos) >= 3 {
            rtype = string(pos[2]);
        }
        return run_os_tool(sub, map("host", string(pos[1]), "type", rtype), as_json);
    }

    if sub == "ssl" or sub == "ssl_check" {
        if len(pos) < 2 {
            return emit_err(as_json, "usage: nettools ssl <host> [port]", 2);
        }
        let p = 443;
        if len(pos) >= 3 {
            p = parse_int_or(string(pos[2]), 443);
        }
        return run_os_tool("ssl_check", map("host", string(pos[1]), "port", p), as_json);
    }

    if sub == "ipconfig" or sub == "ifconfig" or sub == "hostname" or sub == "arp" or sub == "route" or sub == "interfaces" or sub == "netstat" or sub == "connections" or sub == "open_ports" or sub == "net_stats" {
        return run_os_tool(sub, map(), as_json);
    }

    return emit_err(as_json, "unknown command '" + string(pos[0]) + "' (run 'nettools --help')", 2);
}