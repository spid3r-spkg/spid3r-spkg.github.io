// lib.matrix — Public entry module for the Spid3r nettools package.

import "http" as http;
import "validate" as val;
import "ipmath" as ipm;
import "commands" as cmd;

public const VERSION: string = "0.1.0";

public fn is_valid_host(s: string) -> bool {
    return val.is_valid_host(s);
}

public fn is_valid_ipv4(s: string) -> bool {
    return val.is_valid_ipv4(s);
}

public fn is_valid_cidr(s: string) -> bool {
    return val.is_valid_cidr(s);
}

public fn is_valid_port(p: int) -> bool {
    return val.is_valid_port(p);
}

public fn is_valid_http_url(u: string) -> bool {
    return val.is_valid_http_url(u);
}

public fn detect_os() -> string {
    return cmd.detect_os();
}

public fn classify_ipv4(ip: string) {
    return ipm.classify_ipv4(ip);
}

public fn subnet_calc(cidr: string) {
    return ipm.subnet_calc(cidr);
}

public fn ip_range_calc(start_ip: string, end_ip: string) {
    return ipm.ip_range_calc(start_ip, end_ip);
}

public fn os_command_spec(tool: string, params: map, os_name: string) {
    return cmd.os_command_spec(tool, params, os_name);
}

public fn run_os_command(tool: string, params: map) {
    return cmd.run_os_command(tool, params);
}

fn format_target_addr(host: string, port: int) -> string {
    if host.contains(":") and not host.starts_with("[") {
        return "[" + host + "]:" + string(port);
    }
    return host + ":" + string(port);
}

/// Check a single TCP port using Spid3r's native `tcp_connect`.
public fn check_port(host: string, port: int) {
    let h = host.trim();
    if not val.is_valid_host(h) {
        return err("Invalid host: " + host);
    }
    if not val.is_valid_port(port) {
        return err("Port must be between 1 and 65535");
    }
    let addr = format_target_addr(h, port);
    let t0 = now_ms();
    let res = tcp_connect(addr);
    let rtt = now_ms() - t0;
    if res.is_ok() {
        let sock = res.unwrap();
        try {
            tcp_close(sock);
        } catch (_e) {}
        return ok(map(
            "host", h,
            "port", port,
            "address", addr,
            "open", true,
            "rtt_ms", rtt,
            "message", "Connected"
        ));
    }
    return ok(map(
        "host", h,
        "port", port,
        "address", addr,
        "open", false,
        "rtt_ms", rtt,
        "message", string(res.unwrap_err())
    ));
}

/// Perform N sequential TCP handshake probes (`1 <= count <= 10`).
public fn tcp_ping(host: string, port: int, count: int) {
    let h = host.trim();
    if not val.is_valid_host(h) {
        return err("Invalid host: " + host);
    }
    if not val.is_valid_port(port) {
        return err("Port must be between 1 and 65535");
    }
    let n = val.clamp_int(count, 1, 10);
    let addr = format_target_addr(h, port);
    let samples = list();
    let ok_count = 0;
    let sum_ms = 0;
    let min_ms = -1;
    let max_ms = 0;

    let i = 0;
    while i < n {
        let t0 = now_ms();
        let res = tcp_connect(addr);
        let rtt = now_ms() - t0;
        let is_up = res.is_ok();
        let detail = "";
        if is_up {
            ok_count += 1;
            sum_ms += rtt;
            if min_ms < 0 or rtt < min_ms {
                min_ms = rtt;
            }
            if rtt > max_ms {
                max_ms = rtt;
            }
            detail = "Connected";
            try {
                tcp_close(res.unwrap());
            } catch (_e) {}
        } else {
            detail = string(res.unwrap_err());
        }
        samples.push(map(
            "seq", i + 1,
            "open", is_up,
            "rtt_ms", rtt,
            "detail", detail
        ));
        i += 1;
        if i < n {
            sleep_ms(120);
        }
    }

    let avg_ms = 0;
    if ok_count > 0 {
        avg_ms = int(sum_ms / ok_count);
    } else {
        min_ms = 0;
    }
    let loss_pct = int(((n - ok_count) * 100) / n);
    return ok(map(
        "host", h,
        "port", port,
        "address", addr,
        "sent", n,
        "received", ok_count,
        "loss_pct", loss_pct,
        "min_ms", min_ms,
        "avg_ms", avg_ms,
        "max_ms", max_ms,
        "samples", samples
    ));
}

/// Inspect an HTTP(S) URL with Spid3r's native `http_fetch`.
public fn http_inspect(method: string, url: string, headers: map, body: string) {
    let m = method.trim().upper();
    if m != "GET" and m != "HEAD" and m != "POST" and m != "PUT" and m != "DELETE" and m != "OPTIONS" {
        return err("Unsupported HTTP method: " + method);
    }
    if not val.is_valid_http_url(url) {
        return err("Invalid HTTP/HTTPS URL");
    }
    let t0 = now_ms();
    let res = http.http_fetch(m, url.trim(), headers, body, null);
    let elapsed = now_ms() - t0;
    if res.is_err() {
        return err(string(res.unwrap_err()));
    }
    let resp = res.unwrap();
    let resp_body = "";
    if resp.has("body") and resp["body"] != null {
        resp_body = string(resp["body"]);
        if len(resp_body) > 65536 {
            resp_body = resp_body.slice(0, 65536) + "\n... [truncated at 64 KiB]";
        }
    }
    return ok(map(
        "method", m,
        "url", url.trim(),
        "status", resp["status"],
        "headers", resp["headers"],
        "body", resp_body,
        "duration_ms", elapsed
    ));
}

fn doh_request(url: string, hdrs: map) {
    let res = http.http_fetch("GET", url, hdrs, null, null);
    if res.is_err() {
        return err(string(res.unwrap_err()));
    }
    let resp = res.unwrap();
    let st = resp["status"];
    if st != 200 {
        return err("DoH HTTP " + string(st) + " from " + url);
    }
    let body = "";
    if resp.has("body") and resp["body"] != null {
        body = string(resp["body"]).trim();
    }
    if len(body) == 0 {
        return err("Empty DoH response body from " + url);
    }
    try {
        return ok(json_parse(body));
    } catch (e) {
        return err("Invalid DoH JSON: " + string(e));
    }
}

/// Query DNS-over-HTTPS (Cloudflare JSON API, with Google DoH fallback) from Spid3r.
public fn dns_doh(name: string, rtype: string) {
    let h = name.trim();
    let t = rtype.trim().upper();
    if not val.is_valid_host(h) {
        return err("Invalid hostname for DNS query");
    }
    if not val.is_valid_dns_type(t) {
        return err("Unsupported DNS record type: " + rtype);
    }
    let cf_url = "https://cloudflare-dns.com/dns-query?name=" + h + "&type=" + t;
    let goog_url = "https://dns.google/resolve?name=" + h + "&type=" + t;
    let hdrs = map("Accept", "application/dns-json");
    let t0 = now_ms();
    let r = doh_request(cf_url, hdrs);
    if r.is_err() {
        let first_err = string(r.unwrap_err());
        let r2 = doh_request(goog_url, hdrs);
        let elapsed = now_ms() - t0;
        if r2.is_err() {
            return err(first_err + "; fallback failed: " + string(r2.unwrap_err()));
        }
        return ok(map(
            "name", h,
            "type", t,
            "provider", "dns.google",
            "duration_ms", elapsed,
            "response", r2.unwrap()
        ));
    }
    let elapsed = now_ms() - t0;
    return ok(map(
        "name", h,
        "type", t,
        "provider", "cloudflare-dns.com",
        "duration_ms", elapsed,
        "response", r.unwrap()
    ));
}

/// Query RDAP registration metadata for a domain, IP, or ASN (following up to 5 HTTPS redirects).
public fn whois_rdap(query: string) {
    let q = query.trim();
    let path = "";
    if val.is_valid_ipv4(q) or val.is_valid_ipv6(q) {
        path = "ip/" + q;
    } elif val.is_valid_asn(q) {
        let num = q.upper();
        if num.starts_with("AS") {
            num = num.slice(2);
        }
        path = "autnum/" + num;
    } elif val.is_valid_host(q) {
        path = "domain/" + q.lower();
    } else {
        return err("Invalid domain, IP, or ASN for RDAP lookup");
    }
    let current_url = "https://rdap.org/" + path;
    let hdrs = map("Accept", "application/rdap+json, application/json");
    let t0 = now_ms();
    let hops = 0;
    while hops < 5 {
        let res = http.http_fetch("GET", current_url, hdrs, null, null);
        if res.is_err() {
            return err(string(res.unwrap_err()));
        }
        let resp = res.unwrap();
        let st = resp["status"];
        if (st == 301 or st == 302 or st == 303 or st == 307 or st == 308) and resp["headers"].has("location") {
            let loc = string(resp["headers"]["location"]).trim();
            if loc.starts_with("https://") {
                current_url = loc;
                hops = hops + 1;
                continue;
            }
        }
        let elapsed = now_ms() - t0;
        let resp_body = "";
        if resp.has("body") and resp["body"] != null {
            resp_body = string(resp["body"]);
        }
        return ok(map(
            "status", st,
            "url", current_url,
            "duration_ms", elapsed,
            "body", resp_body
        ));
    }
    return err("Too many RDAP redirects from " + current_url);
}
