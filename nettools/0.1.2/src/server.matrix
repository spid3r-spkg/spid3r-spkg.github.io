// server.matrix — Optional loopback-only local companion agent for Spid3r Network Tools.
// Binds strictly to 127.0.0.1 and requires a per-session random X-NetTools-Token header.

import { HttpServer, http_response, http_body_json } from "http";
import "lib" as nt;
import "validate" as val;

fn make_session_token() -> string {
    let rb = random_bytes(16);
    if rb.is_err() {
        throw "OS CSPRNG random_bytes failed: " + string(rb.unwrap_err());
    }
    return hex_encode(rb.unwrap());
}

fn allowed_origin(req: map) -> string {
    if not req.has("headers") or type_of(req["headers"]) != "map" {
        return "";
    }
    let h = req["headers"];
    if not h.has("origin") {
        return "";
    }
    let origin = string(h["origin"]).trim();
    if origin == "https://spid3r-spkg.github.io" or origin.starts_with("http://127.0.0.1:") or origin == "http://127.0.0.1" or origin.starts_with("http://localhost:") or origin == "http://localhost" {
        return origin;
    }
    return "";
}

fn cors_headers(req: map, content_type: string) -> map {
    let hdrs = map("content-type", content_type);
    let origin = allowed_origin(req);
    if len(origin) > 0 {
        hdrs["access-control-allow-origin"] = origin;
        hdrs["vary"] = "Origin";
    }
    hdrs["access-control-allow-methods"] = "GET, POST, OPTIONS";
    hdrs["access-control-allow-headers"] = "Content-Type, X-NetTools-Token";
    hdrs["cache-control"] = "no-store";
    return hdrs;
}

fn json_cors(req: map, status: int, payload: map) {
    return http_response(
        status,
        cors_headers(req, "application/json; charset=utf-8"),
        json_write(payload)
    );
}

fn needs_auth_confirm(tool: string) -> bool {
    return tool == "ping" or tool == "traceroute" or tool == "tcp_ping" or tool == "port_check" or tool == "curl" or tool == "http_headers" or tool == "http_status" or tool == "response_time" or tool == "ssl_check";
}

fn param_str(params: map, key: string, dflt: string) -> string {
    if params != null and params.has(key) and params[key] != null {
        return string(params[key]).trim();
    }
    return dflt;
}

fn param_int(params: map, key: string, dflt: int) -> int {
    if params != null and params.has(key) and params[key] != null {
        try {
            return int(params[key]);
        } catch (_e) {
            return dflt;
        }
    }
    return dflt;
}

fn main() {
    let port = 8787;
    let p_env = env("NETTOOLS_PORT");
    if p_env.is_some() {
        try {
            port = val.clamp_int(int(p_env.unwrap()), 1024, 65535);
        } catch (_e) {}
    }

    let token = make_session_token();
    let os_name = nt.detect_os();
    let app = new HttpServer();
    app.logging = false;

    app.route("OPTIONS", "/*", fn(req) {
        return http_response(204, cors_headers(req, "text/plain; charset=utf-8"), "");
    });

    app.get("/health", fn(req) {
        return json_cors(req, 200, map(
            "ok", true,
            "service", "spid3r-nettools-agent",
            "version", nt.VERSION,
            "os", os_name
        ));
    });

    app.post("/api/run", fn(req) {
        let hdrs = req["headers"];
        let provided = "";
        if hdrs != null and hdrs.has("x-nettools-token") {
            provided = string(hdrs["x-nettools-token"]).trim();
        }
        if len(provided) == 0 or not secure_compare(provided, token) {
            return json_cors(req, 401, map(
                "ok", false,
                "error", "Unauthorized: missing or invalid X-NetTools-Token header"
            ));
        }

        let body_res = http_body_json(req);
        if body_res.is_err() {
            return json_cors(req, 400, map("ok", false, "error", body_res.unwrap_err()));
        }
        let body = body_res.unwrap();
        if type_of(body) != "map" or not body.has("tool") {
            return json_cors(req, 400, map("ok", false, "error", "Request JSON must include 'tool'"));
        }

        let tool = string(body["tool"]).trim().lower();
        let params = map();
        if body.has("params") and type_of(body["params"]) == "map" {
            params = body["params"];
        }
        let authorized = body.has("authorized") and body["authorized"] == true;
        if needs_auth_confirm(tool) and not authorized {
            return json_cors(req, 403, map(
                "ok", false,
                "error", "Authorization confirmation required before running active network probes"
            ));
        }

        if tool == "tcp_ping" {
            let host = param_str(params, "host", "");
            let p = param_int(params, "port", 443);
            let cnt = param_int(params, "count", 4);
            let r = nt.tcp_ping(host, p, cnt);
            if r.is_err() {
                return json_cors(req, 400, map("ok", false, "error", r.unwrap_err()));
            }
            return json_cors(req, 200, map("ok", true, "tool", tool, "os", os_name, "data", r.unwrap()));
        }

        if tool == "port_check" {
            let host = param_str(params, "host", "");
            let p = param_int(params, "port", 443);
            let r = nt.check_port(host, p);
            if r.is_err() {
                return json_cors(req, 400, map("ok", false, "error", r.unwrap_err()));
            }
            return json_cors(req, 200, map("ok", true, "tool", tool, "os", os_name, "data", r.unwrap()));
        }

        if tool == "curl" or tool == "http_headers" or tool == "http_status" or tool == "response_time" {
            let method = param_str(params, "method", "GET");
            if tool == "http_headers" or tool == "http_status" {
                method = param_str(params, "method", "HEAD");
            }
            let url = param_str(params, "url", "");
            let req_hdrs = null;
            if params.has("headers") and type_of(params["headers"]) == "map" {
                req_hdrs = params["headers"];
            }
            let req_body = null;
            if params.has("body") and params["body"] != null {
                req_body = string(params["body"]);
            }
            let r = nt.http_inspect(method, url, req_hdrs, req_body);
            if r.is_err() {
                return json_cors(req, 400, map("ok", false, "error", r.unwrap_err()));
            }
            return json_cors(req, 200, map("ok", true, "tool", tool, "os", os_name, "data", r.unwrap()));
        }

        if tool == "subnet_calc" {
            let r = nt.subnet_calc(param_str(params, "cidr", ""));
            if r.is_err() {
                return json_cors(req, 400, map("ok", false, "error", r.unwrap_err()));
            }
            return json_cors(req, 200, map("ok", true, "tool", tool, "os", os_name, "data", r.unwrap()));
        }

        if tool == "ip_range_calc" {
            let r = nt.ip_range_calc(param_str(params, "start", ""), param_str(params, "end", ""));
            if r.is_err() {
                return json_cors(req, 400, map("ok", false, "error", r.unwrap_err()));
            }
            return json_cors(req, 200, map("ok", true, "tool", tool, "os", os_name, "data", r.unwrap()));
        }

        let res = nt.run_os_command(tool, params);
        return json_cors(req, 200, res);
    });

    let bind_addr = "127.0.0.1:" + string(port);
    let real = app.bind(bind_addr);
    println("Spid3r NetTools Companion Agent v" + nt.VERSION + " (" + os_name + ")");
    println("Loopback URL : http://" + real);
    println("Session Token: " + token);
    println("Paste the URL and Session Token into the Network Tools Web UI -> Local Agent.");
    app.serve(-1);
    return 0;
}
